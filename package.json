{
  "name": "tutoring-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.js",
    "hash-password": "node scripts/hash-password.js",
    "test:auth": "node tests/auth.mjs",
    "test:workflow": "node tests/workflow.mjs",
    "test:serien": "node tests/serien.mjs",
    "test:guthaben": "node tests/guthaben.mjs",
    "test:kontakt": "node tests/kontakt.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
