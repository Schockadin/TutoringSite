# Postgres auf Railway. sslmode=require ist Pflicht: Die Datenbank ist über den
# öffentlichen Endpunkt erreichbar, weil die App auf Netlify läuft und damit
# Railways privates Netz nicht nutzen kann.
DATABASE_URL="postgresql://postgres:PASSWORT@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"

# Passwort-Hash für den einzigen Zugang. Erzeugen mit:  npm run hash-password
# Format: scrypt:N:r:p:salt:hash (Doppelpunkte, kein $ - sonst zerstoert dotenv den Wert)
ADMIN_PASSWORD_HASH=""

# 32 zufällige Bytes, base64. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""
