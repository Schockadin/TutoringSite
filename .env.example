# Postgres auf Railway. sslmode=require ist Pflicht: Die Datenbank ist über den
# öffentlichen Endpunkt erreichbar, weil die App auf Netlify läuft und damit
# Railways privates Netz nicht nutzen kann.
DATABASE_URL="postgresql://postgres:PASSWORT@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"

# Passwort-Hash für den einzigen Zugang. Erzeugen mit:  npm run hash-password
# Format: scrypt:N:r:p:salt:hash
# Die Felder sind mit ":" getrennt, nicht mit "$": Next.js expandiert .env-Werte
# im dotenv-Stil und wuerde "$32768" als Variablenreferenz lesen.
ADMIN_PASSWORD_HASH=""

# Benachrichtigung über neue Kontaktanfragen (optional).
# Fehlt eine der drei Variablen, wird die Nachricht trotzdem gespeichert –
# es geht nur keine E-Mail raus, und der Grund steht am Eintrag im Posteingang.
#
# Wichtig: RESEND_FROM muss eine in Resend VERIFIZIERTE Domain sein.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Nachhilfe <nachhilfe@deine-verifizierte-domain.de>"
NOTIFY_EMAIL="dominic.zander@outlook.de"

# Für den Link in der Benachrichtigungsmail. Ohne Angabe: https://dominic-zander.de
SITE_URL="https://dominic-zander.de"
